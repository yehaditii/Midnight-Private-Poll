# Midnight environment overrides
# Reference only: the scripts do not load .env files automatically.
# Set values in the process environment when needed; never commit real secrets.

MIDNIGHT_INDEXER_URL=
MIDNIGHT_INDEXER_WS_URL=
MIDNIGHT_NODE_URL=
MIDNIGHT_PROOF_SERVER_URL=
MIDNIGHT_FAUCET_URL=
MIDNIGHT_BLOCKFROST_PROJECT_ID=

# Optional wallet credentials for public network deployment
MIDNIGHT_WALLET_SEED=
MIDNIGHT_WALLET_MNEMONIC=

# Local private-state password used by the leveldb provider
# Replace this local-only placeholder with a strong value for public-network use.
PRIVATE_STATE_PASSWORD=Local-Devnet-Development-Placeholder-1

MIDNIGHT_FAUCET_TIMEOUT_MS=
