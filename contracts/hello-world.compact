pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public aggregate state: these counters are stored on-chain and readable by anyone.
export ledger yesVotes: Counter;
export ledger totalVotes: Counter;

// Private input: the DApp supplies this value locally through its witness callback.
witness localVote(): Boolean;

// The individual vote stays private; only the aggregate YES result is disclosed.
export circuit castVote(): [] {
    const vote = localVote();
    if (disclose(vote)) {
        yesVotes.increment(1);
    }
    totalVotes.increment(1);
}
